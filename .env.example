# Copy to .env for local development:  cp .env.example .env
# Values match docker-compose.yml. NEVER reuse these anywhere real.
APP_ENV=local
BIND_ADDR=127.0.0.1:8080
METRICS_ADDR=127.0.0.1:9100
LOG_FORMAT=pretty
RUST_LOG=info,securedrop_api=debug,tower_http=info,sqlx=warn

DATABASE_URL=postgres://securedrop:securedrop-local-only@127.0.0.1:55432/securedrop
REDIS_URL=redis://:securedrop-local-only@127.0.0.1:56379/0

# 32+ random bytes. Generate one with:  openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-0123456789abcdefghijklmnop

S3_BUCKET=securedrop-local
S3_ENDPOINT_URL=http://127.0.0.1:59000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:59000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=securedrop-local
AWS_SECRET_ACCESS_KEY=securedrop-local-secret

CORS_ALLOWED_ORIGINS=http://localhost:3000
